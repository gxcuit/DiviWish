{
  "name": "diviwish-web",
  "version": "0.6.1",
  "private": true,
  "description": "A/H 股息观察网站：Cloudflare Workers、D1 与邮箱验证码账号",
  "author": "JCodesMore",
  "license": "MIT",
  "keywords": [
    "dividend",
    "fenhong",
    "nextjs",
    "cloudflare-workers",
    "d1"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "backend": "node scripts/backend.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/preview.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run cf:dry-run && npm run test:runtime && npm run test:linuxdo:runtime",
    "dev:legacy": "node scripts/dev-legacy.mjs",
    "backend:legacy": "node scripts/backend-legacy.mjs",
    "test": "node --experimental-strip-types --test worker/tests/*.test.ts",
    "cf:types": "wrangler types worker/env.d.ts --env-interface WorkerBindings --strict-vars false --include-runtime false",
    "cf:dry-run": "wrangler deploy --env= --dry-run --outdir .local/deploy",
    "cf:dry-run:production": "wrangler deploy --env production --dry-run --outdir .local/deploy-production",
    "cf:deploy": "wrangler deploy --env production",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "test:runtime": "node scripts/test-runtime.mjs",
    "resend:setup": "node scripts/setup-resend.mjs",
    "resend:status": "node scripts/setup-resend.mjs --status",
    "test:linuxdo:runtime": "node scripts/test-linuxdo-runtime.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.35.0",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  }
}

# npm scripts load .env.local automatically (optional; no configuration is required).
# Relative database paths resolve from web/. Defaults shown below:
DIVIDEND_DATABASE=.local/standalone/diviwish.sqlite3
WEB_PORT=3000
API_PORT=8787
# Used by npm start; Docker sets HOST=0.0.0.0 inside its isolated network.
HOST=127.0.0.1
# Only needed for an explicitly chosen LAN/reverse-proxy access address:
# APP_ORIGIN=http://192.168.1.10:3000
